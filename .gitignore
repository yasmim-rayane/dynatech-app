# ══════════════════════════════════════════════
#  DynaTech — .gitignore (monorepo)
# ══════════════════════════════════════════════

# ─── Dependências ────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Build / Produção ───────────────────────
dist/
build/

# ─── Testes ──────────────────────────────────
coverage/

# ─── Variáveis de ambiente ───────────────────
.env
.env*.local

# ─── IDEs e editores ────────────────────────
.idea/
.vscode/
*.swp
*.swo
*.ntvs*
*.njsproj
*.sln
*.suo

# ─── OS ──────────────────────────────────────
.DS_Store
Thumbs.db
*.pem

# ─── Logs ────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Java / Spring Boot (Backend) ───────────
apps/backend/target/
apps/backend/.idea/

# ─── Android (Capacitor) ────────────────────
apps/mobile/android/.gradle/
apps/mobile/android/.idea/
apps/mobile/android/.kotlin/
apps/mobile/android/build/
apps/mobile/android/app/build/
apps/mobile/android/app/release/
apps/mobile/android/app/debug/
apps/mobile/android/local.properties
apps/mobile/android/capacitor-cordova-android-plugins/

# ─── Quarentena (arquivos isolados da auditoria) ──
_quarantine/
